{
  "name": "quarantine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "replay": "tsx scripts/replay.ts",
    "mocks": "tsx scripts/mocks.ts",
    "record": "tsx scripts/record.ts",
    "mcp": "tsx scripts/mcp.ts",
    "sentinel": "tsx scripts/sentinel.ts",
    "eval": "tsx scripts/eval.ts",
    "bench": "tsx scripts/bench.ts 6379 6.0.2 && tsx scripts/bench.ts 6380 4.22.1",
    "readme": "tsx scripts/readme.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@langchain/openai": "1.6.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@quarantine/graph": "workspace:*",
    "@quarantine/swarm": "workspace:*",
    "falkordb": "6.8.0"
  }
}
